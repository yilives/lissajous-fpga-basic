set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE22E22C8
set_global_assignment -name TOP_LEVEL_ENTITY ad9226_ad9764_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE ad9226_ad9764_test.sdc

set_global_assignment -name ENABLE_CONFIGURATION_PINS OFF
set_global_assignment -name USE_CONFIGURATION_DEVICE OFF
set_global_assignment -name RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"

set_global_assignment -name VERILOG_FILE ad9226_ad9764_top.v
set_global_assignment -name VERILOG_FILE conv_clk_10m_pll.v
set_global_assignment -name VERILOG_FILE reference_sin_rom1024.v
set_global_assignment -name VERILOG_FILE adc_block_iq_pll.v
set_global_assignment -name VERILOG_FILE i2c_master.v
set_global_assignment -name VERILOG_FILE ssd1306_oled.v
set_global_assignment -name VERILOG_FILE font_8x16.v
set_global_assignment -name VERILOG_FILE uart_tx.v
set_global_assignment -name VERILOG_FILE uart_rx.v
set_global_assignment -name VERILOG_FILE uart_byte_fifo.v
set_global_assignment -name VERILOG_FILE uart2_dds_control.v

# Core-board 50 MHz oscillator (CLK2, package pin 24).
set_location_assignment PIN_24 -to clk_50m
# PIN_83 is tied to the module ground; keep FPGA side input-only (high impedance drive).
set_location_assignment PIN_83 -to gnd_guard_83
# S3: IO85 is externally pulled high and grounded while pressed.
set_location_assignment PIN_85 -to vision_key_n
# S4: IO87 is externally pulled high and grounded while pressed.
set_location_assignment PIN_87 -to mode_key_n

# AD9764: D0 (LSB) through D13 (MSB), then its sampling clock.
set_location_assignment PIN_100 -to dac_data[0]
set_location_assignment PIN_99 -to dac_data[1]
set_location_assignment PIN_103 -to dac_data[2]
set_location_assignment PIN_101 -to dac_data[3]
set_location_assignment PIN_105 -to dac_data[4]
set_location_assignment PIN_104 -to dac_data[5]
set_location_assignment PIN_110 -to dac_data[6]
set_location_assignment PIN_106 -to dac_data[7]
set_location_assignment PIN_112 -to dac_data[8]
set_location_assignment PIN_111 -to dac_data[9]
set_location_assignment PIN_114 -to dac_data[10]
set_location_assignment PIN_113 -to dac_data[11]
set_location_assignment PIN_119 -to dac_data[12]
set_location_assignment PIN_115 -to dac_data[13]
set_location_assignment PIN_121 -to dac_clk

# 3PA1030: D0 (LSB) through D9 (MSB), OE (active-low), OTR, and clock.
set_location_assignment PIN_77 -to adc_data[0]
set_location_assignment PIN_76 -to adc_data[1]
set_location_assignment PIN_72 -to adc_data[2]
set_location_assignment PIN_71 -to adc_data[3]
set_location_assignment PIN_69 -to adc_data[4]
set_location_assignment PIN_68 -to adc_data[5]
set_location_assignment PIN_67 -to adc_data[6]
set_location_assignment PIN_66 -to adc_data[7]
set_location_assignment PIN_65 -to adc_data[8]
set_location_assignment PIN_64 -to adc_data[9]
set_location_assignment PIN_59 -to adc_oe
set_location_assignment PIN_60 -to adc_otr
set_location_assignment PIN_58 -to adc_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_50m
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gnd_guard_83
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vision_key_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to mode_key_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dac_data[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dac_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to adc_data[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to adc_oe
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to adc_otr
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to adc_clk

# AD9764 sees data updated on the falling edge before its next rising edge.
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to dac_data[*]
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to dac_data[*]
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to dac_clk
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to adc_clk
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to adc_oe
set_instance_assignment -name PRESERVE_REGISTER ON -to adc_sample[*]
set_instance_assignment -name PRESERVE_REGISTER ON -to adc_otr_sample

# 0.91" OLED SSD1306 I2C
set_location_assignment PIN_142 -to oled_scl
set_location_assignment PIN_144 -to oled_sda
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to oled_scl
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to oled_sda
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to oled_scl
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to oled_sda

# UART1: 115200 baud
set_location_assignment PIN_141 -to uart1_txd
set_location_assignment PIN_143 -to uart1_rxd
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart1_txd
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart1_rxd

# UART2: 115200 baud
set_location_assignment PIN_133 -to uart2_txd
set_location_assignment PIN_136 -to uart2_rxd
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart2_txd
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart2_rxd

set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Standard Edition"

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
